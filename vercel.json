{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/api/dist/vercel.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/apps/api/dist/vercel.js" },
    { "source": "/api/:path*", "destination": "/apps/api/dist/vercel.js" }
  ]
}
