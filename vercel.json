{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd \"$VERCEL_PROJECT_DIR\" && rm -f package-lock.json && npm install --include=dev --include=optional --no-audit --no-fund && npm run build --workspace packages/shared && cd apps/api && npx prisma@6.19.3 generate",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "apps/admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "apps/api/src/vercel.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/apps/api/src/vercel.ts" },
    { "source": "/api/:path*", "destination": "/apps/api/src/vercel.ts" },
    { "source": "/admin", "destination": "/apps/admin/dist/index.html" },
    { "source": "/admin/:path*", "destination": "/apps/admin/dist/index.html" },
    { "source": "/:path*", "destination": "/apps/web/dist/index.html" }
  ]
}