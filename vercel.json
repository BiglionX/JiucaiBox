{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/apps/web/dist/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/apps/web/dist/admin/index.html" }
  ]
}