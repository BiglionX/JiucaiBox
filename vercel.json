{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "apps/web/dist", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/apps/web/dist/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/apps/web/dist/admin/index.html" }
  ]
}