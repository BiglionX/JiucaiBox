// 韭菜学院 / JiucaiBox 数据库模型
// 生产环境使用 MySQL（Vercel 单项目部署要求）；
// schema 仅使用可移植类型（Int/String/Boolean/DateTime/Json/Float），不依赖方言特性。

generator client {
  provider = "prisma-client-js"
  // 自定义输出到应用内目录：避免与 node_modules 中被占用/锁定的默认生成目录冲突，
  // 也方便 monorepo 内直接引用生成代码
  output   = "../src/generated/prisma"
}

datasource db {
  // 生产：MySQL 8（Vercel 单项目部署要求；本地也可继续用 MySQL 调试）。
  // 若要在本地临时切回 SQLite 零依赖开发，把 provider 改回 "sqlite" 并把 DATABASE_URL 指到 file:./dev.db。
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 用户 ----------
model User {
  id              Int                @id @default(autoincrement())
  openid          String?            @unique
  phone           String?            @unique
  nickname        String
  avatar          String?
  bio             String?
  isAnonymous     Boolean            @default(true)
  status          String             @default("active") // active | banned
  createdAt       DateTime           @default(now())
  lastActiveAt    DateTime           @default(now())
  analysisReports AnalysisReport[]
  stories         Story[]
  comments        StoryComment[]
  hugs            StoryHug[]
  notifications   AppNotification[]
  learningRecords LearningRecord[]
  testResults     UserTestResult[]
  certificates    Certificate[]
}

// ---------- 管理后台用户 ----------
model AdminUser {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  nickname   String
  role       String   @default("content_ops") // super_admin | content_ops | reviewer | support | analyst
  createdAt  DateTime @default(now())
  lastLoginAt DateTime?
  logs       OperationLog[]
}

// ---------- 课程 / 视频 ----------
model Course {
  id               Int             @id @default(autoincrement())
  title            String
  description      String?
  coverUrl         String?
  category         String          @default("truth") // live | finance | franchise | experience | truth | other
  isFree           Boolean         @default(true)
  learnerCount     Int             @default(0)
  sort             Int             @default(0)
  // —— 课程画像（教学化）——
  difficulty       String          @default("entry")        // entry | intermediate | advanced
  targetAudience   String          @default("all")          // all | newcomer | parent | founder | senior
  estimatedMinutes Int             @default(0)              // 课程总时长（分钟），由视频求和自动覆写
  summary          String?                                  // 一句话简介（卡片/列表展示）
  outcomes         Json            @default("[]")           // 学习目标 ["了解 X","识别 Y"...]
  warningTips      Json            @default("[]")           // 警示要点 ["切勿 ...","必查 ..."]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  videos           Video[]
  quizQuestions    QuizQuestion[]
  radioEpisodes    RadioEpisode[]
  certificates     Certificate[]
}

model Video {
  id              Int              @id @default(autoincrement())
  courseId        Int
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  coverUrl        String?
  videoUrl        String
  duration        Int              @default(0)
  description     String?
  order           Int              @default(0)
  popup           Popup?
  learningRecords LearningRecord[]
  createdAt       DateTime         @default(now())

  @@index([courseId])
}

// 真相弹窗
model Popup {
  id      Int    @id @default(autoincrement())
  videoId Int    @unique
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  content String
}

// 收益预期校准测试题
model QuizQuestion {
  id            Int              @id @default(autoincrement())
  courseId      Int
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter       Int              @default(1)
  question      String
  options       Json
  correctOption Int
  explanation   String?
  userResults   UserTestResult[]
}

model UserTestResult {
  id         Int          @id @default(autoincrement())
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Int
  correct    Boolean
  createdAt  DateTime     @default(now())

  @@unique([userId, questionId])
}

// ---------- 反割韭菜测评 ----------
model AnalysisReport {
  id            Int      @id @default(autoincrement())
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceUrl     String?
  sourceType    String   @default("video") // video | article | other
  inputText     String
  riskLevel     String? // high | medium | low
  status        String   @default("pending") // pending | done | failed
  failReason    String?
  aiResult      Json?
  deepFeedback  Json?
  deepRiskLevel String?
  reviewed      Boolean  @default(false)
  reviewerNote  String?
  reviewedBy    String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// ---------- 韭菜的泪花（UGC 社区）----------
model Story {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userNickname String
  category     String         @default("other") // live | finance | franchise | other
  lossAmount   Float?
  lossTypes    Json           @default("[]") // ["money","time",...]
  title        String
  content      String
  lesson       String?
  images       Json           @default("[]")
  status       String         @default("pending") // pending | approved | rejected
  rejectReason String?
  createdAt    DateTime       @default(now())
  comments     StoryComment[]
  hugs         StoryHug[]

  @@index([status])
  @@index([category])
}

model StoryComment {
  id           Int      @id @default(autoincrement())
  storyId      Int
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userNickname String
  content      String
  createdAt    DateTime @default(now())
}

model StoryHug {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

// ---------- 韭菜电台 ----------
model RadioEpisode {
  id              Int      @id @default(autoincrement())
  title           String
  sourceUrl       String?
  sourceLabel     String   @default("官方通报")
  coverUrl        String?
  summary         String
  tricks          Json     @default("[]") // [{name, description}]
  warning         String?
  relatedCourseId Int?
  relatedCourse   Course?  @relation(fields: [relatedCourseId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

// ---------- 通知 ----------
model AppNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("system") // system | review | interaction | cert_issued
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- 学习证书 ----------
// 用户完成课程（全部"有时长"的视频达成 watchedSeconds ≥ duration×90%）时颁发。
// (userId, courseId) 唯一，避免重复颁发。
model Certificate {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // 颁发时刻的视频快照（用户昵称 / 课程名）防止后续资料被修改后证书失真
  userNicknameSnapshot  String
  courseTitleSnapshot   String
  // 预留 PDF 链接位（当前 MVP 不生成真实 PDF，仅留字段供后续接入）
  pdfUrl      String?
  issuedAt    DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ---------- 学习记录 ----------
model LearningRecord {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId        Int
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  courseId       Int
  watchedSeconds Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId, courseId])
}

// ---------- 风险词库 ----------
model RiskWord {
  id        Int      @id @default(autoincrement())
  word      String
  category  String // income | urgency | fakeCase | opaque | compliance
  weight    Float    @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([word, category])
}

// ---------- 管理后台操作日志 ----------
model OperationLog {
  id        Int      @id @default(autoincrement())
  adminId   Int?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminName String
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}
