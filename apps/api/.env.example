# ===== 运行环境 =====
NODE_ENV=development
PORT=3000

# ===== 数据库 =====
# 生产 / Vercel 单项目部署：MySQL 8（schema.prisma 的 provider 固定为 mysql）
# 示例：mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="mysql://jiucaibox:jiucaibox_123456@localhost:3306/jiucaibox"

# 本地若想临时切回 SQLite 零依赖调试：把 schema.prisma 的 provider 改回 "sqlite"，并把 url 改为：
# DATABASE_URL="file:./dev.db"

# ===== JWT =====
JWT_SECRET=jiucaibox-dev-secret-change-me-in-production
JWT_EXPIRES_IN=30d

# ===== AI 大模型（可选；未配置时使用内置规则引擎完成测评）=====
# 支持 DeepSeek 兼容的 OpenAI 协议端点
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 前端地址（CORS）=====
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ===== 管理后台初始账号（seed 使用）=====
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=jiucai123456
