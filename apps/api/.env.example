# ===== 运行环境 =====
NODE_ENV=development
PORT=3000

# ===== 数据库 =====
# 生产 / Vercel 单项目部署：TiDB Cloud Serverless（MySQL 协议，免费档）
# TiDB 控制台 → 集群 → Connect → 选 Prisma → 直接复制它给你的 DATABASE_URL
# 模板（占位符需自行替换；真实密码严禁提交到仓库或粘贴到聊天窗口）：
#   mysql://2LiXAyJwaq1teF5.root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/jiucaibox
#
# 重要：
# 1. 末尾数据库名必须是业务库（推荐 jiucaibox），不能是 /sys（TiDB 系统库，迁移会失败）。
#    先在 TiDB SQL Editor 执行：CREATE DATABASE jiucaibox;
# 2. TiDB 要求 TLS。从 TiDB Connect 面板复制出来的 URL 已自带 ?ssl=... 参数，Prisma 直连即可，
#    不要手动去掉。
# 3. 本地用同一段 URL 跑迁移 + seed；Vercel 项目里把同一段填到环境变量 DATABASE_URL。

DATABASE_URL="mysql://2LiXAyJwaq1teF5.root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/jiucaibox"

# 本地若想临时切回 SQLite 零依赖调试：把 schema.prisma 的 provider 改回 "sqlite"，并把 url 改为：
# DATABASE_URL="file:./dev.db"

# ===== JWT =====
JWT_SECRET=jiucaibox-dev-secret-change-me-in-production
JWT_EXPIRES_IN=30d

# ===== AI 大模型（可选；未配置时使用内置规则引擎完成测评）=====
# 支持 DeepSeek 兼容的 OpenAI 协议端点
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 前端地址（CORS）=====
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ===== 管理后台初始账号（seed 使用）=====
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=jiucai123456
