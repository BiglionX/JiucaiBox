{
  "name": "jiucaibox",
  "version": "0.1.0",
  "private": true,
  "description": "韭菜学院 / JiucaiBox —— 一所没有围墙的防割大学（monorepo）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:admin": "npm run dev --workspace apps/admin",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web && npm run build --workspace apps/admin",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:admin": "npm run build --workspace apps/admin",
    "db:generate": "npm run prisma:generate --workspace apps/api",
    "db:migrate": "npm run prisma:migrate --workspace apps/api",
    "db:seed": "npm run prisma:seed --workspace apps/api",
    "start:api": "npm run start:prod --workspace apps/api",
    "postinstall": "cd apps/api && node -e \"process.argv.push('generate','--schema=./prisma/schema.prisma'); require('prisma')\""
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3"
  }
}
