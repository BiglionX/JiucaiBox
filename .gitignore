# Dependencies
node_modules/

# Local Vercel CLI tools
.vercel-tools/

# npm local cache (workspace)
.npm-cache/

# Build outputs
dist/
build/
*.tsbuildinfo
apps/api/prisma/dev.db*
apps/api/api*.log

# Env & secrets
.env
.env.local
.env.*.local
!.env.example

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
apps/api/prisma/migrations/dev.db

# Prisma generated client (regenerated via prisma generate, do not commit)
apps/api/src/generated/

# package-lock.json intentionally not tracked on this monorepo:
# Vercel sandbox runs `npm install --include=optional` on Linux to install
# platform-specific rollup native binaries, which would otherwise be skipped
# if the lockfile was generated on a different platform (npm/cli#4828).
package-lock.json

# Logs
logs/
*.log
npm-debug.log*
api*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploads
uploads/
